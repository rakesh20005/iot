/* Parcel Handoff Verifier - Arduino IDE board: ESP32 Dev Module */
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <HTTPClient.h>
#include <time.h>

const char* WIFI_SSID = "";
const char* WIFI_PASS = "";
const char* TS_API_KEY = "";

const int ENTRY = 25, TRAY_A = 26, TRAY_B = 27;  // Active-low IR outputs
const int CLK = 32, DT = 33;                    // Rotary encoder
const int GREEN = 18, RED = 19;
const int irPins[] = {ENTRY, TRAY_A, TRAY_B};
extern const char ROOT_CA[];  // ThingSpeak's certificate authority is below loop()

enum { NONE, A, B };
enum { READY, CORRECT, WRONG, UNCONFIRMED };
int selected = A, expected = NONE;
int result = READY, lastExpected = NONE, lastObserved = NONE;
unsigned long count[4] = {}, enteredAt = 0, handoffMs = 0, lastUpload = 0;
int rawIR[3], stableIR[3], previousCLK;
unsigned long changedAt[3] = {};
bool uploadPending = true;

void setup() {
  Serial.begin(115200);
  for (int i = 0; i < 3; i++) {
    pinMode(irPins[i], INPUT_PULLUP);
    rawIR[i] = stableIR[i] = digitalRead(irPins[i]);
  }
  pinMode(CLK, INPUT_PULLUP);
  pinMode(DT, INPUT_PULLUP);
  previousCLK = digitalRead(CLK);
  pinMode(GREEN, OUTPUT);
  pinMode(RED, OUTPUT);
  digitalWrite(GREEN, LOW);
  digitalWrite(RED, LOW);

  if (WIFI_SSID[0] && TS_API_KEY[0]) {
    WiFi.mode(WIFI_STA);
    WiFi.setAutoReconnect(true);
    WiFi.begin(WIFI_SSID, WIFI_PASS);
  }
  Serial.println("Ready. Route A selected.");
}

// Read a fresh detection after the IR signal has been stable for 20 ms.
bool detected(int i, unsigned long now) {
  int reading = digitalRead(irPins[i]);
  if (reading != rawIR[i]) {
    rawIR[i] = reading;
    changedAt[i] = now;
  }
  if (reading == stableIR[i] || now - changedAt[i] < 20) return false;
  stableIR[i] = reading;
  return reading == LOW;
}

void readEncoder() {
  int clk = digitalRead(CLK);
  if (previousCLK == HIGH && clk == LOW) {
    int route = digitalRead(DT) == HIGH ? B : A;
    if (route != selected) {
      selected = route;
      Serial.println(selected == A ? "Next parcel: Tray A" : "Next parcel: Tray B");
    }
  }
  previousCLK = clk;
}

void checkParcel(unsigned long now) {
  bool entry = detected(0, now);
  bool trayA = detected(1, now);
  bool trayB = detected(2, now);

  if (expected == NONE) {
    if (entry) {
      expected = selected;
      enteredAt = now;
      digitalWrite(GREEN, LOW);
      digitalWrite(RED, LOW);
      Serial.println(expected == A ? "In transit to A" : "In transit to B");
    }
    return;
  }

  handoffMs = now - enteredAt;
  bool timedOut = handoffMs >= 10000 || (trayA && trayB);
  if (!timedOut && !trayA && !trayB) return;

  lastExpected = expected;
  lastObserved = timedOut ? NONE : (trayA ? A : B);
  result = timedOut ? UNCONFIRMED : (lastObserved == expected ? CORRECT : WRONG);
  count[result]++;
  expected = NONE;
  digitalWrite(GREEN, result == CORRECT);
  digitalWrite(RED, result != CORRECT);

  const char* messages[] = {"Ready", "Correct route", "Wrong tray", "Unconfirmed"};
  Serial.println(messages[result]);
  uploadPending = true;
}

void uploadToThingSpeak(unsigned long now) {
  if (!uploadPending || expected != NONE || WiFi.status() != WL_CONNECTED) return;

  static bool clockStarted = false;
  if (!clockStarted) {
    configTime(0, 0, "pool.ntp.org", "time.google.com");
    clockStarted = true;
    Serial.println("Wi-Fi connected. Preparing ThingSpeak.");
  }
  if (time(nullptr) < 1700000000 || now - lastUpload < 20000) return;
  lastUpload = now;

  WiFiClientSecure client;
  client.setCACert(ROOT_CA);
  client.setHandshakeTimeout(3);

  HTTPClient http;
  http.setConnectTimeout(2500);
  http.setTimeout(2500);
  if (!http.begin(client, "https://api.thingspeak.com/update")) return;

  http.addHeader("Content-Type", "application/x-www-form-urlencoded");
  http.addHeader("THINGSPEAKAPIKEY", TS_API_KEY);
  String data = "field1=" + String(count[CORRECT]) + "&field2=" + String(count[WRONG])
              + "&field3=" + String(count[UNCONFIRMED]) + "&field4=" + String(result)
              + "&field5=" + String(lastExpected) + "&field6=" + String(lastObserved)
              + "&field7=" + String(handoffMs);

  int status = http.POST(data);
  long entry = status == 200 ? http.getString().toInt() : 0;
  http.end();

  if (entry > 0) {
    uploadPending = false;
    Serial.printf("ThingSpeak saved entry %ld\n", entry);
  } else {
    Serial.printf("ThingSpeak upload pending (HTTP %d)\n", status);
  }
}

void loop() {
  unsigned long now = millis();
  readEncoder();
  checkParcel(now);
  uploadToThingSpeak(now);
  delay(2);
}

